# Copy to /srv/appdata/docker/kanban/secrets/app.env (chmod 600). Not committed.

# Must match the public URL exactly (scheme + host, no trailing slash). Used for CSRF/WebSocket origin checks.
PUBLIC_ORIGIN=https://kanban.example.com

# Password must match POSTGRES_PASSWORD in secrets/db.env
DATABASE_URL=postgres://kanban:change-me@kanban-db:5432/kanban

# Must match the identity in secrets/seaweedfs-s3.json
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-long-random

SESSION_DAYS=30

# Encrypts the SMTP password, webhook URLs/tokens, 2FA secrets and the push key in the database.
# Create with:  docker run --rm <kanban image> kanban gen-key   (or ./target/release/kanban gen-key)
# Keep a copy with your backups: without it those secrets can't be read (2FA would need resetting,
# SMTP and webhooks re-entering).
SECRET_KEY=change-me-64-hex-characters
