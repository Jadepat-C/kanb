# Copy to deploy/.env, or let ./setup.sh write it with random passwords. Keep it private (chmod 600).

# The address people type in their browser: scheme + host (+ port), no trailing slash.
# Requests from any other origin are refused (CSRF protection), so this must match exactly.
KANB_URL=https://kanb.example.com

# true when people reach Kanb over https (normal). false only for trying it out over plain http,
# e.g. http://192.168.1.20:8080 — browsers drop "Secure" cookies there and sign-in would fail.
COOKIE_SECURE=true

# Where the app listens on this machine. Keep 127.0.0.1 when a reverse proxy on the same host serves https.
# 0.0.0.0:8080 = reachable from your network; a Tailscale/VPN IP works too.
KANB_BIND=127.0.0.1:8080

# true: a reverse proxy on this machine/network passes on each visitor's address (X-Forwarded-For), which the sign-in
# rate limits use. Set false if the app is reachable directly from the internet with no proxy in front, so visitors
# can't fake their address.
TRUST_PROXY=true

# Database and uploaded files live here (relative to this folder, or an absolute path). Back it up.
KANB_DATA=./data

# Time zone for dates in chat posts (Discord, Slack…), calendar feeds and recurring cards.
TZ=UTC

# Random values; use letters and digits only (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=kanb
S3_SECRET_KEY=change-me

# 64 hex characters (`openssl rand -hex 32`). Encrypts the SMTP password, webhook secrets, 2FA secrets and the
# browser-push key in the database. Keep a copy with your backups: without it those can't be read back.
SECRET_KEY=change-me

# Asked for when you create the first admin in the browser (only while there are no accounts yet).
# If empty, a random code is printed in the log instead: docker compose logs app
SETUP_CODE=change-me

# Optional
# The app image (default ghcr.io/jadepat-c/kanb:latest). Pin a release with :0.1, follow main with :edge, or use a
# name that isn't on any registry (e.g. kanb:local) to always build from this checkout with `up -d --build`.
# KANB_IMAGE=ghcr.io/jadepat-c/kanb:latest
# SESSION_DAYS=30
# MAX_UPLOAD_MB=50
